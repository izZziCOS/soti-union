---
import "~/styles/global.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import { company } from "~/data/company";
import {
  defaultLocale,
  localeLabels,
  localizePath,
  locales,
  parsePathname,
  useTranslations,
  type Locale,
} from "~/i18n";
import defaultOgImage from "~/assets/images/hero-workshop.jpg";

interface Props {
  locale: Locale;
  /** Page-specific title; omit on the home page to use the tagline. */
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
  jsonLd?: Record<string, unknown>;
}

const { locale, title, description, ogImage = defaultOgImage, jsonLd } = Astro.props;
const t = useTranslations(locale);
const { path } = parsePathname(Astro.url.pathname);

const fullTitle = title ? `${title} | ${company.name}` : `${company.name} — ${t.meta.tagline}`;
const metaDescription = description ?? t.meta.description;
const canonical = new URL(localizePath(path, locale), Astro.site);
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: "cover", format: "jpg" });
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#191744" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizePath(path, l), Astro.site)} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath(path, defaultLocale), Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeLabels[locale].og} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-spark-500 px-4 py-2 font-semibold text-brand-950 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.nav.skipToContent}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
