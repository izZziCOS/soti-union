---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import CtaBand from "~/components/CtaBand.astro";
import Icon, { type IconName } from "~/components/Icon.astro";
import NewsFeed from "~/components/NewsFeed.astro";
import { company } from "~/data/company";
import { localizePath, localeStaticPaths, resolveLocale, routes, useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import hero from "~/assets/images/hero-welding.jpg";
import hullBlock from "~/assets/images/hull-block.jpg";
import oilGas from "~/assets/images/markets/oil-gas.jpg";
import shipbuilding from "~/assets/images/markets/shipbuilding.jpg";
import steelConstruction from "~/assets/images/markets/steel-construction.jpg";
import windOffshore from "~/assets/images/markets/wind-offshore.jpg";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = resolveLocale(Astro.params.lang);
const t = useTranslations(locale);

const marketImages: Record<string, ImageMetadata> = {
  shipbuilding,
  wind: windOffshore,
  oilgas: oilGas,
  steel: steelConstruction,
};
const workModeIcons: IconName[] = ["hardhat", "factory"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: company.name,
  legalName: company.legalName,
  url: Astro.site?.href,
  email: company.email,
  telephone: company.phones.director,
  foundingDate: company.founded,
  vatID: company.vatCode,
  description: t.meta.description,
  address: {
    "@type": "PostalAddress",
    streetAddress: company.address.street,
    postalCode: company.address.postalCode,
    addressLocality: company.address.city,
    addressCountry: company.address.countryCode,
  },
};
---

<BaseLayout locale={locale} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-brand-950">
    <Image
      src={hero}
      alt={t.home.hero.imageAlt}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full -scale-x-100 object-cover object-[30%_center]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950 via-brand-950/85 to-brand-950/20"></div>
    <div class="container-page flex min-h-[78dvh] flex-col justify-center py-24 lg:py-32">
      <div class="max-w-2xl animate-fade-up">
        <p class="eyebrow text-spark-400!">{t.home.hero.eyebrow}</p>
        <h1 class="mt-5 text-4xl leading-[1.08] font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
          {t.home.hero.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">{t.home.hero.lead}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={localizePath(routes.contact, locale)} class="btn-primary">
            {t.common.getInTouch}
            <Icon name="arrow-right" class="size-4" />
          </a>
          <a href={localizePath(routes.references, locale)} class="btn-ghost">
            {t.common.viewReferences}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="container-page relative z-10 -mt-12">
    <dl class="grid grid-cols-2 divide-slate-200 rounded-2xl border border-slate-200 bg-white shadow-xl shadow-brand-950/5 lg:grid-cols-4 lg:divide-x">
      {t.home.stats.map(({ value, label }) => (
        <div class="flex flex-col-reverse gap-1 p-6 sm:p-8">
          <dt class="text-sm text-slate-500">{label}</dt>
          <dd class="text-3xl font-bold tracking-tight text-brand-700 sm:text-4xl">{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Services -->
  <section class="container-page py-20 lg:py-28" aria-labelledby="services-title">
    <div class="max-w-2xl">
      <p class="eyebrow">{t.home.services.eyebrow}</p>
      <h2 id="services-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.home.services.title}
      </h2>
      <p class="mt-4 text-lg text-slate-600">{t.home.services.intro}</p>
    </div>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.home.services.items.map(({ icon, title, text }) => (
        <li class="card group transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md">
          <span class="inline-flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
            <Icon name={icon as IconName} class="size-6" />
          </span>
          <h3 class="mt-5 text-lg font-semibold">{title}</h3>
          <p class="mt-2 leading-relaxed text-slate-600">{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Markets -->
  <section class="bg-slate-50 py-20 lg:py-28" aria-labelledby="markets-title">
    <div class="container-page">
      <p class="eyebrow">{t.home.markets.eyebrow}</p>
      <h2 id="markets-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.home.markets.title}
      </h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.home.markets.items.map(({ key, title, alt }) => {
          const src = marketImages[key];
          return (
            <li class="group relative aspect-[4/3] overflow-hidden sm:aspect-[3/4] rounded-2xl bg-brand-900">
              {src && (
                <Image
                  src={src}
                  alt={alt}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                  class="size-full object-cover transition duration-700 group-hover:scale-105"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/20 to-transparent" />
              <h3 class="absolute inset-x-0 bottom-0 p-6 text-xl font-semibold text-white">
                {title}
              </h3>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- How we work -->
  <section class="container-page py-20 lg:py-28" aria-labelledby="work-title">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">{t.home.workModes.eyebrow}</p>
        <h2 id="work-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {t.home.workModes.title}
        </h2>
        <ul class="mt-10 space-y-8">
          {t.home.workModes.items.map(({ title, text }, i) => (
            <li class="flex gap-5">
              <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-xl bg-spark-500/15 text-spark-700">
                <Icon name={workModeIcons[i] ?? "check"} class="size-6" />
              </span>
              <div>
                <h3 class="text-lg font-semibold">{title}</h3>
                <p class="mt-1.5 leading-relaxed text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 -z-10 rounded-3xl bg-brand-50" aria-hidden="true"></div>
        <Image
          src={hullBlock}
          alt={t.home.aboutTeaser.imageAlt}
          widths={[450]}
          sizes="(min-width: 1024px) 560px, 100vw"
          class="aspect-[3/2] w-full rounded-2xl object-cover shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="bg-brand-950 text-white">
    <div class="container-page grid gap-10 py-20 lg:grid-cols-[1fr_1.2fr] lg:items-center lg:py-24">
      <div>
        <p class="eyebrow text-spark-400!">{t.home.aboutTeaser.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {t.home.aboutTeaser.title}
        </h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed text-slate-300">{t.home.aboutTeaser.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localizePath(routes.about, locale)} class="btn-primary">
            {t.common.learnMore}
            <Icon name="arrow-right" class="size-4" />
          </a>
          <a href={localizePath(routes.references, locale)} class="btn-ghost">
            {t.common.viewReferences}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest news: shown by the news script once posts have loaded -->
  <section
    class="container-page py-20 lg:py-28"
    aria-labelledby="news-title"
    data-news-section
    hidden
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{t.news.latestEyebrow}</p>
        <h2 id="news-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {t.news.latestTitle}
        </h2>
      </div>
      <a
        href={localizePath(routes.news, locale)}
        class="inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600"
      >
        {t.news.viewAll}
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>
    <div class="mt-12">
      <NewsFeed locale={locale} mode="latest" />
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
