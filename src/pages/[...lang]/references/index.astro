---
import Gallery from "~/components/Gallery.astro";
import Icon from "~/components/Icon.astro";
import PageHeader from "~/components/PageHeader.astro";
import CtaBand from "~/components/CtaBand.astro";
import { localeStaticPaths, localizePath, resolveLocale, routes, useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import g1 from "~/assets/images/gallery/01.jpg";
import g2 from "~/assets/images/gallery/02.jpg";
import g3 from "~/assets/images/gallery/03.jpg";
import g4 from "~/assets/images/gallery/04.jpg";
import g5 from "~/assets/images/gallery/05.jpg";
import g6 from "~/assets/images/gallery/06.jpg";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = resolveLocale(Astro.params.lang);
const t = useTranslations(locale);

const galleryImages = [g1, g2, g3, g4, g5, g6].map((src, i) => ({
  src,
  alt: t.references.gallery[i] ?? "",
}));
---

<BaseLayout
  locale={locale}
  title={t.references.title}
  description={t.references.description}
  ogImage={g2}
>
  <PageHeader
    eyebrow={t.references.eyebrow}
    heading={t.references.heading}
    lead={t.references.lead}
  />

  <section class="container-page py-20 lg:py-28" aria-labelledby="timeline-title">
    <h2 id="timeline-title" class="sr-only">
      {t.references.timelineTitle}
    </h2>
    <ol class="relative mx-auto max-w-3xl border-l-2 border-slate-200">
      {t.references.items.map((item) => (
        <li class="relative pb-10 pl-8 last:pb-0 sm:pl-10">
          <span
            class="absolute top-1.5 -left-[9px] size-4 rounded-full border-4 border-white bg-spark-500 ring-1 ring-slate-200"
            aria-hidden="true"
          />
          <p class="text-sm font-bold tracking-wide text-spark-700">{item.year}</p>
          <h3 class="mt-1 text-xl font-semibold">{item.client}</h3>
          <p class="mt-0.5 text-sm text-slate-500">{item.location}</p>
          <p class="mt-2 leading-relaxed text-slate-600">{item.text}</p>
          {item.story && (
            <a
              href={localizePath(routes.aidaprima, locale)}
              class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-500"
            >
              {t.common.readStory}
              <Icon name="arrow-right" class="size-4" />
            </a>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-slate-50 py-20 lg:py-28" aria-labelledby="gallery-title">
    <div class="container-page">
      <h2 id="gallery-title" class="text-3xl font-bold tracking-tight sm:text-4xl">
        {t.references.galleryTitle}
      </h2>
      <div class="mt-10">
        <Gallery images={galleryImages} labels={t.references.lightbox} />
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
